# Your TypeSafe API key. Create one at https://console.typesafe.ai/
# Copy this file to .env and paste the key after the = sign.
TYPESAFE_API_KEY=

# Optional: pin a Jev version instead of the moving alias, e.g. jev-1.13.0
JEVGRAM_MODEL=jev-latest

# Optional: where the web app listens (defaults shown)
JEVGRAM_HOST=127.0.0.1
JEVGRAM_PORT=8000
